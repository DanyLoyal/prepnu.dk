# --- Database ---
# Lokal Postgres, eller Supabase/Neon. Ved Supabase: brug "Transaction/Session
# pooler"-forbindelsen (IPv4), ikke "Direct connection" (kun IPv6).
# Supabases rod-CA (certs/supabase-ca.crt) bruges automatisk til TLS-verificering
# i src/lib/db-ssl.ts hvis filen findes — ellers falder vi tilbage til pg's standard.
DATABASE_URL="postgresql://user:password@localhost:5432/beredskab?schema=public"

# --- Auth.js (admin login) ---
AUTH_SECRET="" # generer selv en tilfældig værdi, fx: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_EMAIL="admin@example.com"
# Generer med: npx tsx scripts/hash-password.ts "dit-password"
# VIGTIGT (kun i lokal .env, ikke på Netlify): Next.js' .env-loader fortolker "$"
# som variabel-interpolation (fx "$2b" = variablen 2b). Et bcrypt-hash starter
# altid med "$2b$12$...", så i DENNE fil skal hvert "$" escapes som "\$" — ellers
# bliver hashet trunkeret og login fejler stille. I Netlifys UI skal hashet
# derimod indsættes helt råt/uescaped (Netlify parser ikke .env-filer).
ADMIN_PASSWORD_HASH=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Resend (transaktionsmails) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"

# --- Leverandører ---
BIGBUY_API_KEY=""
BIGBUY_API_BASE_URL="https://api.sandbox.bigbuy.eu" # byt til https://api.bigbuy.eu i produktion

CJ_DROPSHIPPING_API_KEY=""
CJ_DROPSHIPPING_API_BASE_URL="https://developers.cjdropshipping.com"

# --- Cron ---
CRON_SECRET="" # bruges til at beskytte /api/cron/* ruter

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
